<Application x:Class="Qovx.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#090B10"/>
        <SolidColorBrush x:Key="CardDark" Color="#141824"/>
        <SolidColorBrush x:Key="CardDarkHover" Color="#1C2233"/>
        <SolidColorBrush x:Key="BorderDark" Color="#262B38"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRose" Color="#E11D48"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextWhite" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
