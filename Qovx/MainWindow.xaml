<Window x:Class="Qovx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QOVX - Windows System &amp; Network Control Suite" Height="700" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextWhite}"
        FontFamily="Segoe UI"
        MinWidth="920" MinHeight="620">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#0EA5E9" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="QV" FontWeight="ExtraBold" FontSize="15" Foreground="#090B10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QOVX" FontWeight="ExtraBold" FontSize="17" Foreground="{StaticResource TextWhite}"/>
                        <TextBlock Text="System &amp; Network Control Suite v2.0.4" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#122229" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12,5">
                    <TextBlock x:Name="TxtZeroTelemetry" Text="● %100 Çevrimdışı • Sıfır Telemetri" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnYouTube" Click="BtnYouTube_Click" Background="#E11D48" BorderBrush="#BE123C" BorderThickness="1" Margin="0,0,10,0" Padding="14,7">
                        <TextBlock Text="ALLAHVERDİ CAN (YouTube)" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                    </Button>

                    <Button x:Name="BtnLang" Click="BtnLang_Click" Background="{StaticResource CardDarkHover}" BorderBrush="{StaticResource AccentCyan}" Padding="12,7">
                        <TextBlock x:Name="TxtLangLabel" Text="Dil: TR (EN'ye Geç)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyan}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#10131C" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <Button x:Name="NavDash" Click="Nav_Click" Tag="Dash" Background="{StaticResource CardDarkHover}" BorderBrush="{StaticResource AccentCyan}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtDash" Text="Sistem Özeti &amp; Hızlandır" FontWeight="SemiBold" FontSize="13"/>
                    </Button>
                    <Button x:Name="NavRam" Click="Nav_Click" Tag="Ram" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtRam" Text="Bellek (RAM) Yönetimi" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                    </Button>
                    <Button x:Name="NavDisk" Click="Nav_Click" Tag="Disk" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtDisk" Text="Disk &amp; Kopya Temizleyici" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                    </Button>
                    <Button x:Name="NavNet" Click="Nav_Click" Tag="Net" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtNet" Text="Ağ, DNS &amp; Gecikme" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                    </Button>
                    <Button x:Name="NavPriv" Click="Nav_Click" Tag="Priv" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtPriv" Text="Gizlilik &amp; Telemetri" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                    </Button>
                    <Button x:Name="NavStart" Click="Nav_Click" Tag="Start" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtStart" Text="Güç, Uyku Kilidi &amp; Araçlar" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24">

                <Grid x:Name="TabDash" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock x:Name="TxtDashTitle" Text="Sistem Performans &amp; Kontrol Paneli" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextWhite}"/>
                        <TextBlock x:Name="TxtDashSubtitle" Text="Gerçek donanım verilerini yerel olarak inceleyin ve tek adımla sistem bakımını çalıştırın." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="CardTxtRam" Text="Fiziksel Bellek Yükü" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="ValRamPercent" Text="64%" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ValRamBytes" Text="Hesaplanıyor..." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock x:Name="CardTxtTrash" Text="Temizlenebilir Önbellek" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="ValTempSize" Text="Taranıyor..." FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ValTempDesc" Text="%TEMP% ve Shader dizinleri" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="CardTxtDns" Text="Aktif DNS Yanıt Süresi" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="ValDnsPing" Text="11 ms" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ValDnsProvider" Text="Primary Edge (1.1.1.1)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="32">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="BtnMasterBoost" Click="BtnMasterBoost_Click" Background="{StaticResource AccentCyan}" BorderThickness="0" Padding="36,16" Cursor="Hand">
                                <TextBlock x:Name="TxtBtnMaster" Text="SİSTEM OPTİMİZASYONUNU BAŞLAT" FontSize="15" FontWeight="Bold" Foreground="#090B10"/>
                            </Button>
                            <TextBlock x:Name="TxtBoostStatus" Text="Boştaki RAM çalışma kümeleri daraltılır, önbellek dizinleri silinir ve DNS sıfırlanır." HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            <ProgressBar x:Name="PbBoost" Height="6" Width="380" Visibility="Collapsed" Margin="0,12,0,0" Foreground="{StaticResource AccentCyan}" Background="{StaticResource BorderDark}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="TabRam" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtRamTitle" Text="Bellek (RAM) Çalışma Kümesi Yönetimi" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtRamSubtitle" Text="Windows EmptyWorkingSet API çağrısı ile açık uygulamaları kapatmadan pasif bellek bloklarını boşaltır." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,20"/>

                        <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtLiveRam" Text="Canlı Fiziksel Bellek Durumu:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtRamDetail" Text="Okunuyor..." FontSize="13" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ChkAutoRam" Content="Bellek yükü %82'yi aştığında otomatik boşalt" IsChecked="True" Foreground="{StaticResource TextWhite}" Margin="0,0,0,16"/>
                                <Button x:Name="BtnPurgeRam" Click="BtnPurgeRam_Click" Background="{StaticResource AccentCyan}" BorderThickness="0" Padding="20,10" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtBtnPurgeRam" Text="Bellek Çalışma Kümesini Şimdi Boşalt" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TabDisk" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtDiskTitle" Text="Depolama Temizliği &amp; SHA-256 Kopya Dosya Tarayıcı" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtDiskSubtitle" Text="Geçici sistem dosyalarını, DirectX Shader önbelleğini ve birebir aynı kopya dosyaları temizleyin." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,20"/>

                        <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox x:Name="ChkUserTemp" Content="Kullanıcı Geçici Dizinleri (%TEMP%)" IsChecked="True" Foreground="{StaticResource TextWhite}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkWinTemp" Content="Windows Sistem Geçici Dizinleri (C:\Windows\Temp)" IsChecked="True" Foreground="{StaticResource TextWhite}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkUpdateCache" Content="İndirilenler Klasörü SHA-256 Kopya Dosya Analizi" IsChecked="True" Foreground="{StaticResource TextWhite}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkThumbnails" Content="DirectX Gölgelendirici (D3DSCache) Önbelleği" IsChecked="True" Foreground="{StaticResource TextWhite}" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnScanDisk" Click="BtnScanDisk_Click" Background="{StaticResource CardDarkHover}" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtBtnScanDisk" Text="Önbellek ve Kopyaları Tara" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnCleanDisk" Click="BtnCleanDisk_Click" Background="{StaticResource AccentAmber}" BorderThickness="0">
                                        <TextBlock x:Name="TxtBtnCleanDisk" Text="Seçili Önbellekleri Temizle" FontWeight="Bold" Foreground="#090B10"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="TxtDiskResult" Text="" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource AccentEmerald}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TabNet" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtNetTitle" Text="Ağ Tanılama, DNS Kıyaslama &amp; Soket Onarımı" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtNetSubtitle" Text="Genel DNS çözümleyicilerine canlı ICMP ping testi yapın ve DNS/ARP önbelleğini sıfırlayın." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,20"/>

                        <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="BtnTestPing" Click="BtnTestPing_Click" Background="{StaticResource AccentCyan}" BorderThickness="0" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtBtnTestPing" Text="Canlı DNS Gecikme Testini Başlat" FontWeight="Bold" Foreground="#090B10"/>
                                    </Button>
                                    <Button x:Name="BtnFlushDns" Click="BtnFlushDns_Click" Background="{StaticResource CardDarkHover}">
                                        <TextBlock x:Name="TxtBtnFlushDns" Text="DNS ve ARP Önbelleğini Temizle" FontWeight="SemiBold"/>
                                    </Button>
                                </StackPanel>

                                <TextBlock x:Name="TxtPingResults" Text="Henüz test çalıştırılmadı." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextWhite}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TabPriv" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtPrivTitle" Text="Gizlilik Ayarları &amp; Telemetri Sınırlandırma" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtPrivSubtitle" Text="Kayıt defteri üzerinden reklam kimliği takibini, web arama sorgularını ve arka plan kaydını kapatın." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,20"/>

                        <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <CheckBox x:Name="ChkAdId" Content="Reklam Kimliği (AdvertisingInfo) Takibini Devre Dışı Bırak" IsChecked="True" Foreground="{StaticResource TextWhite}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkDiagnostic" Content="Arka Plan Oyun Kaydı (GameDVR) Yükünü Kapat" IsChecked="True" Foreground="{StaticResource TextWhite}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkStartWeb" Content="Başlat Menüsü Web Arama Sorgularını Kapat" IsChecked="True" Foreground="{StaticResource TextWhite}" Margin="0,0,0,16"/>

                                <Button x:Name="BtnApplyPrivacy" Click="BtnApplyPrivacy_Click" Background="{StaticResource AccentEmerald}" BorderThickness="0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtBtnApplyPrivacy" Text="Kayıt Defteri Gizlilik Kurallarını Uygula" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                                <TextBlock x:Name="TxtPrivResult" Text="" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource AccentEmerald}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TabStart" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtStartTitle" Text="Güç Planları, Uyku Kilidi &amp; Zamanlayıcı" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStartSubtitle" Text="Nihai Performans güç şemasını açın, uyku kilidini başlatın veya otomatik kapatma zamanlayıcısı kurun." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,20"/>

                        <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button x:Name="BtnOpenStartup" Click="BtnOpenStartup_Click" Background="{StaticResource CardDarkHover}" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtBtnOpenStartup" Text="Uyku Kilidini (Uyanık Tut) Başlat" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnUnlockPower" Click="BtnUnlockPower_Click" Background="{StaticResource AccentAmber}" BorderThickness="0">
                                        <TextBlock Text="Nihai Performans Güç Planını Aç" FontWeight="Bold" Foreground="#090B10"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnShutdownTimer" Click="BtnShutdownTimer_Click" Background="{StaticResource AccentCyan}" BorderThickness="0" Margin="0,0,10,0">
                                        <TextBlock Text="60 Dk Sonra Otomatik Kapat" FontWeight="Bold" Foreground="#090B10"/>
                                    </Button>
                                    <Button x:Name="BtnCancelShutdown" Click="BtnCancelShutdown_Click" Background="{StaticResource CardDarkHover}">
                                        <TextBlock Text="Zamanlayıcıyı İptal Et" FontWeight="SemiBold"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0B0D14" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="QOVX v2.0.4 • Yayıncı: ALLAHVERDİ CAN • %100 Yerel Mimari" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <TextBlock HorizontalAlignment="Right" Text="Windows 10 / 11 x64 Native" FontSize="11" Foreground="{StaticResource TextMuted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
