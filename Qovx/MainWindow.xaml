<Window x:Class="Qovx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QOVX - Windows System &amp; Network Control Suite" Height="780" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDark}"
        Foreground="{DynamicResource TextWhite}"
        FontFamily="Segoe UI"
        MinWidth="980" MinHeight="680">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="#0EA5E9" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="QV" FontWeight="ExtraBold" FontSize="15" Foreground="#090B10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QOVX" FontWeight="ExtraBold" FontSize="17" Foreground="{DynamicResource TextWhite}"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Performans &amp; Sistem Kontrol Merkezi v4.0.1" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#122229" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12,5">
                    <TextBlock x:Name="TxtZeroTelemetry" Text="● Sıfır Veri Toplama • Yalnızca Kullanıcı İsteğiyle DNS/Web" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnModeSwitch" Click="BtnModeSwitch_Click" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource AccentCyan}" BorderThickness="1.5" Margin="0,0,10,0" Padding="13,7">
                        <TextBlock x:Name="TxtModeSwitch" Text="🛠️ Gelişmiş Mod (Pro)'ya Geç" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentCyan}"/>
                    </Button>

                    <Button x:Name="BtnPinTop" Click="BtnPinTop_Click" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource BorderDark}" Margin="0,0,8,0" Padding="10,7">
                        <TextBlock x:Name="TxtPinTop" Text="📌 Üstte Tut: Kapalı" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextWhite}"/>
                    </Button>

                    <Button x:Name="BtnSoundToggle" Click="BtnSoundToggle_Click" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource BorderDark}" Margin="0,0,8,0" Padding="10,7">
                        <TextBlock x:Name="TxtSoundLabel" Text="🔊 Ses: Açık" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextWhite}"/>
                    </Button>

                    <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource BorderDark}" Margin="0,0,8,0" Padding="10,7">
                        <TextBlock x:Name="TxtThemeLabel" Text="🌙 Tema: Koyu" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextWhite}"/>
                    </Button>

                    <Button x:Name="BtnLang" Click="BtnLang_Click" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource AccentCyan}" Margin="0,0,8,0" Padding="12,7">
                        <TextBlock x:Name="TxtLangLabel" Text="Dil: TR (EN'ye Geç)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentCyan}"/>
                    </Button>

                    <Button x:Name="BtnYouTube" Click="BtnYouTube_Click" Background="#E11D48" BorderBrush="#BE123C" BorderThickness="1" Padding="12,7">
                        <TextBlock x:Name="TxtBtnYouTube" Text="ALLAHVERDİ CAN (YouTube)" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebar" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION (Visible in Pro Mode) -->
            <Border x:Name="BdrSidebar" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel>
                    <Button x:Name="NavDash" Click="Nav_Click" Tag="Dash" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource AccentCyan}" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtDash" Text="Sistem Özeti &amp; Hızlandır" FontWeight="SemiBold" FontSize="13"/>
                    </Button>
                    <Button x:Name="NavRam" Click="Nav_Click" Tag="Ram" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtRam" Text="Bellek (RAM) Yönetimi" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                    <Button x:Name="NavDisk" Click="Nav_Click" Tag="Disk" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtDisk" Text="Disk &amp; Kopya Temizleyici" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                    <Button x:Name="NavNet" Click="Nav_Click" Tag="Net" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtNet" Text="Ağ, DNS &amp; Gecikme" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                    <Button x:Name="NavPriv" Click="Nav_Click" Tag="Priv" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtPriv" Text="Gizlilik &amp; Başlangıç" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                    <Button x:Name="NavStart" Click="Nav_Click" Tag="Start" Background="Transparent" BorderThickness="0" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="12,10">
                        <TextBlock x:Name="NavTxtStart" Text="Güç, Uyku Kilidi &amp; Araçlar" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Button>

                    <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtSysHealthLabel" Text="Kullanılabilir Bellek Oranı" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="ValHealthScore" Text="Ölçülüyor..." FontSize="19" FontWeight="ExtraBold" Foreground="{DynamicResource AccentEmerald}" Margin="0,4,0,4"/>
                            <TextBlock x:Name="TxtUptimeInfo" Text="Çalışma Süresi: Hesaplanıyor..." FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Column="1" Margin="24,18,24,18">

                <!-- SIMPLE MODE (AKILLI MOD - DEFAULT) -->
                <Grid x:Name="GridSimpleMode" Visibility="Visible">
                    <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1.5" CornerRadius="18" Padding="34,26">
                        <Grid>
                            <!-- Subtle Ambient Acrylic/Glass Glow Accent -->
                            <Ellipse Width="340" Height="340" Fill="{DynamicResource AccentCyan}" Opacity="0.07" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" IsHitTestVisible="False"/>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680">
                                <!-- Top Mode Badge -->
                                <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource AccentCyan}" BorderThickness="1" CornerRadius="14" Padding="14,5" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock x:Name="TxtSimpleBadge" Text="⚡ AKILLI OPTİMİZASYON MERKEZİ • %100 YEREL MİMARİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                                </Border>

                                <!-- Clean Status Headline -->
                                <TextBlock x:Name="TxtSimpleHeroState" Text="Sisteminiz optimize ve akıcı" FontSize="26" FontWeight="ExtraBold" Foreground="{DynamicResource TextWhite}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtSimpleHeroSub" Text="Tek dokunuşla uygulama önbelleklerini, çökme dökümlerini, pasif bellek sayfalarını ve başlangıç yükünü güvenle optimize edin." FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,22"/>

                                <!-- Giant Tactile Smart Boost Button with Pulsing Ring & Rotating Progress Arc -->
                                <Grid Width="210" Height="210" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <Ellipse x:Name="EllSimplePulseRing" Width="204" Height="204" Stroke="{DynamicResource AccentCyan}" StrokeThickness="2" Opacity="0.28" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="ScaleSimplePulseRing" ScaleX="1.0" ScaleY="1.0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <Ellipse x:Name="EllSimpleSpinRing" Width="192" Height="192" Stroke="{DynamicResource AccentEmerald}" StrokeThickness="3.5" StrokeDashArray="16 10" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="RotSimpleSpinRing" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <Button x:Name="BtnSimpleSmartBoost" Click="BtnSimpleSmartBoost_Click" Width="174" Height="174" Background="#0EA5E9" BorderBrush="#38BDF8" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BoostOrbBorder" Width="174" Height="174" CornerRadius="87" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BoostOrbBorder" Property="Background" Value="#38BDF8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="BoostOrbBorder" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="BoostOrbBorder" Property="Background" Value="#1E293B"/>
                                                        <Setter TargetName="BoostOrbBorder" Property="BorderBrush" Value="#0EA5E9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M13,2 L4,14 H11 L10,22 L20,10 H13 Z" Fill="#090B10" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="TxtBtnSimpleBoostMain" Text="SİSTEMİ" FontSize="15" FontWeight="ExtraBold" Foreground="#090B10" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtBtnSimpleBoostSub" Text="OPTİMİZE ET" FontSize="15" FontWeight="ExtraBold" Foreground="#090B10" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 3 Minimal Live Telemetry Pills -->
                                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,7" Margin="4,0">
                                        <TextBlock x:Name="TxtSimplePillRam" Text="Bellek Yükü: Ölçülüyor..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}"/>
                                    </Border>
                                    <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,7" Margin="4,0">
                                        <TextBlock x:Name="TxtSimplePillCache" Text="Geçici Önbellek: Taranıyor..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentAmber}"/>
                                    </Border>
                                    <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,7" Margin="4,0">
                                        <TextBlock x:Name="TxtSimplePillStartup" Text="Başlangıç Öğesi: Denetleniyor..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentEmerald}"/>
                                    </Border>
                                </WrapPanel>

                                <!-- Step-by-Step Progress Panel (Visible During Optimization) -->
                                <Border x:Name="BdrSimpleProgressCard" Visibility="Collapsed" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource AccentCyan}" BorderThickness="1" CornerRadius="10" Padding="18,12" Width="560" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtSimpleStageLabel" Text="Önbellekler taranıyor..." FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextWhite}"/>
                                            <TextBlock x:Name="TxtSimplePercent" Text="0%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="PbSimpleBoost" Height="9" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentCyan}" Background="{DynamicResource BorderDark}" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Animated Success Card (Fade-In & Scale-Up + Glowing Checkmark) -->
                                <Border x:Name="BdrSimpleSuccessCard" Visibility="Collapsed" Background="{DynamicResource CardDarkHover}" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="12" Padding="18,14" Width="600" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ScaleSimpleSuccessCard" ScaleX="0.92" ScaleY="0.92"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BdrSuccessCheckBadge" Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#10B981" VerticalAlignment="Center" Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="ScaleSuccessCheckBadge" ScaleX="1.0" ScaleY="1.0"/>
                                            </Border.RenderTransform>
                                            <Path Data="M6,12.5 L10.5,17 L18.5,8" Stroke="#061410" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSimpleSuccessTitle" Text="Optimizasyon Başarıyla Tamamlandı" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentEmerald}"/>
                                            <TextBlock x:Name="TxtSimpleSuccessReport" Text="Sistem hızı optimize edildi." FontSize="12" Foreground="{DynamicResource TextWhite}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 1: DASHBOARD (PRO MODE) -->
                <Grid x:Name="TabDash" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtDashTitle" Text="Sistem Performans &amp; Kontrol Paneli" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                        <TextBlock x:Name="TxtDashSubtitle" Text="Gerçek donanım verilerini yerel olarak inceleyin ve güvenli sistem bakımını çalıştırın." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="CardTxtRam" Text="Fiziksel Bellek Yükü" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="ValRamPercent" Text="--" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ValRamBytes" Text="Hesaplanıyor..." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock x:Name="CardTxtTrash" Text="Mevcut Geçici Önbellek" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="ValTempSize" Text="Taranıyor..." FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentAmber}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ValTempDesc" Text="%TEMP%, Tarayıcı ve Shader Önbelleği" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="CardTxtDns" Text="Gerçek DNS Sorgu Medyanı" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="ValDnsPing" Text="Ölçülmedi" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentEmerald}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ValDnsProvider" Text="Test için Ağ sekmesini kullanın" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="26">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="BtnMasterBoost" Click="BtnMasterBoost_Click" Background="{DynamicResource AccentCyan}" BorderThickness="0" Padding="36,16">
                                <TextBlock x:Name="TxtBtnMaster" Text="HIZLI BAKIM VE ÖNBELLEK TEMİZLİĞİNİ BAŞLAT" FontSize="15" FontWeight="Bold" Foreground="#090B10"/>
                            </Button>
                            <TextBlock x:Name="TxtBoostStatus" Text="Kritik sistem süreçlerini koruyarak kullanıcı süreçlerinin çalışma kümelerini daraltır, kilitsiz %TEMP% dosyalarını siler ve DNS önbelleğini sıfırlar." HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"/>
                            <Border x:Name="BdrBoostProgressPanel" Visibility="Collapsed" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16,12" Width="540" Margin="0,14,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtBoostStageLabel" Text="Sistem bakım adımları yürütülüyor..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock x:Name="TxtBoostPercent" Text="0%" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="PbBoost" Height="10" Minimum="0" Maximum="100" Value="0" Visibility="Visible" Foreground="{DynamicResource AccentCyan}" Background="{DynamicResource BorderDark}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtHardwareSummary" Text="" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TAB 2: RAM MANAGEMENT & TOP PROCESSES -->
                <Grid x:Name="TabRam" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="TxtRamTitle" Text="Güvenli Bellek (RAM) Çalışma Kümesi Yönetimi" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtRamSubtitle" Text="Not: EmptyWorkingSet fiziksel RAM üretmez; kullanıcı uygulamalarının pasif bellek sayfalarını çalışma kümesinden daraltır. Oturum-0 ve çekirdek süreçleri korunur." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,14"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TxtLiveRam" Text="Canlı Fiziksel Bellek Durumu:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtRamDetail" Text="Okunuyor..." FontSize="13" Foreground="{DynamicResource AccentCyan}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtRamLastReport" Text="Son İşlem: Henüz çalışma kümesi daraltma işlemi çalıştırılmadı." FontSize="12" Foreground="{DynamicResource AccentEmerald}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ChkAutoRam" Content="Bellek yükü %88'i aştığında otomatik daralt (İsteğe Bağlı • 5 dk soğuma süreli)" IsChecked="False" Foreground="{DynamicResource TextWhite}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button x:Name="BtnPurgeRam" Click="BtnPurgeRam_Click" Background="{DynamicResource AccentCyan}" BorderThickness="0" Padding="18,9" Margin="0,0,10,6">
                                    <TextBlock x:Name="TxtBtnPurgeRam" Text="Kullanıcı Süreçlerinin Çalışma Kümesini Daralt" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                                <Button x:Name="BtnRefreshProc" Click="BtnRefreshProc_Click" Background="{DynamicResource CardDarkHover}" Padding="14,9" Margin="0,0,10,6">
                                    <TextBlock x:Name="TxtBtnRefreshProc" Text="Süreç Listesini Yenile" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="BtnTrimSelectedProc" Click="BtnTrimSelectedProc_Click" Background="{DynamicResource AccentEmerald}" BorderThickness="0" Padding="14,9" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtBtnTrimSelectedProc" Text="Seçili Sürecin Çalışma Kümesini Daralt" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                            </WrapPanel>
                            <ProgressBar x:Name="PbRamOp" Height="7" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{DynamicResource AccentCyan}" Background="{DynamicResource BorderDark}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtTopProcHeader" Grid.Row="0" Text="En Çok Bellek Tüketen Aktif Süreçler (İlk 15 • PID ve Başlangıç Zamanı Doğrulamalı)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <ListBox x:Name="LstTopProcesses" Grid.Row="1" Background="{DynamicResource BgSidebar}" Foreground="{DynamicResource TextWhite}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 3: DISK & SHA-256 DUPLICATE CLEANER -->
                <Grid x:Name="TabDisk" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="TxtDiskTitle" Text="Depolama Temizliği &amp; Doğrulamalı SHA-256 Kopya Yöneticisi" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtDiskSubtitle" Text="Sembolik bağlantıları (Junction/Symlink) atlayarak önbellekleri temizler; kopya dosyaları yeniden doğrulayıp Geri Dönüşüm Kutusu'na taşır." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,12"/>
                    </StackPanel>

                    <!-- 3 SEPARATE ACCURATE DISK METRICS (Section 19.2) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="LblMetricCache" Text="1. Mevcut Önbellek Boyutu" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtMetricCurrentCache" Text="0.0 MB" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentAmber}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock x:Name="LblMetricFreed" Text="2. Gerçekten Silinen Alan" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtMetricFreedSpace" Text="0.0 MB (0 dosya)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentEmerald}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LblMetricDup" Text="3. Kopya Dosya Potansiyel Kazancı" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtMetricDupPotential" Text="0.0 MB (0 kopya)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox x:Name="ChkUserTemp" Content="Kullanıcı Geçici Dizinleri (%TEMP%)" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,18,6"/>
                                <CheckBox x:Name="ChkWinTemp" Content="Windows Temp Dizini (Yönetici İzni Gerekebilir)" IsChecked="False" Foreground="{DynamicResource TextWhite}" Margin="0,0,18,6"/>
                                <CheckBox x:Name="ChkUpdateCache" Content="İndirilenler &amp; Belgeler SHA-256 Kopya Taraması" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,18,6"/>
                                <CheckBox x:Name="ChkThumbnails" Content="DirectX Shader (D3DSCache) Önbelleği" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,18,6"/>
                                <CheckBox x:Name="ChkBrowserCache" Content="Tarayıcı Önbellekleri (Yalnızca Kapalıysa Temizlenir)" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,18,6"/>
                                <CheckBox x:Name="ChkCrashDumps" Content="Uygulama Çökme Dökümleri (CrashDumps &amp; WER Raporları)" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,18,6"/>
                            </WrapPanel>

                            <WrapPanel>
                                <Button x:Name="BtnScanDisk" Click="BtnScanDisk_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,8,6">
                                    <TextBlock x:Name="TxtBtnScanDisk" Text="Önizleme ve Kopyaları Tara" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="BtnSelectDupFolder" Click="BtnSelectDupFolder_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,8,6">
                                    <TextBlock x:Name="TxtBtnSelectDupFolder" Text="Özel Klasör Seç &amp; Kopya Ara" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="BtnCleanDisk" Click="BtnCleanDisk_Click" Background="{DynamicResource AccentAmber}" BorderThickness="0" Margin="0,0,8,6">
                                    <TextBlock x:Name="TxtBtnCleanDisk" Text="Seçili Önbellekleri Temizle" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                                <Button x:Name="BtnCancelDiskOp" Click="BtnCancelDiskOp_Click" Background="{DynamicResource CardDarkHover}" IsEnabled="False" Margin="0,0,8,6">
                                    <TextBlock x:Name="TxtBtnCancelDiskOp" Text="İşlemi Durdur" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="BtnDeleteSelectedDup" Click="BtnDeleteSelectedDup_Click" Background="#E11D48" BorderThickness="0" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtBtnDeleteSelectedDup" Text="Seçili Kopyayı Doğrula &amp; Geri Dönüşüme Gönder" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Button>
                            </WrapPanel>
                            <ProgressBar x:Name="PbDiskOp" Height="8" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,8,0,4" Foreground="{DynamicResource AccentAmber}" Background="{DynamicResource BorderDark}" BorderThickness="0"/>
                            <TextBlock x:Name="TxtDiskResult" Text="" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource AccentEmerald}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtDupListHeader" Grid.Row="0" Text="Tespit Edilen SHA-256 Kopya Dosyalar (Kopya Konumu ➔ Orijinal Dosya Konumu)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <ListBox x:Name="LstDuplicates" Grid.Row="1" Background="{DynamicResource BgSidebar}" Foreground="{DynamicResource TextWhite}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 4: NETWORK, DNS BENCHMARK & SOCKET REPAIR -->
                <Grid x:Name="TabNet" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="TxtNetTitle" Text="Ağ Tanılama, Çoklu Örneklem UDP/TCP DNS Kıyaslama &amp; Onarım" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtNetSubtitle" Text="Rastgele Transaction ID, QR/RCODE/Soru doğrulaması ve TCP/53 yedeklemesiyle 3'er örneklem üzerinden Min/Medyan/Maks DNS gecikmesini ölçün." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,16"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="BtnTestPing" Click="BtnTestPing_Click" Background="{DynamicResource AccentCyan}" BorderThickness="0" Margin="0,0,10,6">
                                    <TextBlock x:Name="TxtBtnTestPing" Text="Çoklu Örneklem DNS &amp; ICMP Testini Başlat" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                                <Button x:Name="BtnFlushDns" Click="BtnFlushDns_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,10,6">
                                    <TextBlock x:Name="TxtBtnFlushDns" Text="DNS ve ARP Önbelleğini Sıfırla" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="BtnResetWinsock" Click="BtnResetWinsock_Click" Background="{DynamicResource AccentEmerald}" BorderThickness="0" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtBtnResetWinsock" Text="Winsock &amp; TCP/IP Sıfırla (Yönetici)" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                            </WrapPanel>

                            <TextBlock x:Name="TxtPingResults" Text="Henüz test çalıştırılmadı." TextWrapping="Wrap" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource TextWhite}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtAdapterHeader" Grid.Row="0" Text="Aktif Ağ Adaptörleri, Yerel IPv4, DNS Sunucuları ve Ağ Geçidi Bilgileri" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <ListBox x:Name="LstNetAdapters" Grid.Row="1" Background="{DynamicResource BgSidebar}" Foreground="{DynamicResource TextWhite}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 5: STATE-PRESERVING REVERSIBLE PRIVACY & STARTUP INSPECTOR -->
                <Grid x:Name="TabPriv" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="TxtPrivTitle" Text="Durum Yedeklemeli Gizlilik Ayarları &amp; Başlangıç Denetçisi" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtPrivSubtitle" Text="Değişiklik öncesi mevcut Registry değerleriniz yerel JSON yedeğine kaydedilir; geri alma işlemi önceki kişisel ayarlarınızı birebir geri yükler." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,16"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="ChkAdId" Content="Reklam Kimliği Takibini Kapat (HKCU\...\AdvertisingInfo -> Enabled = 0)" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkDiagnostic" Content="Xbox GameDVR Arka Plan Oyun/Ekran Kaydını Kapat (GameDVR_Enabled &amp; AppCaptureEnabled = 0)" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkStartWeb" Content="Başlat Menüsü Bing Web Arama Önerilerini Kapat (DisableSearchBoxSuggestions = 1)" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkTelemetryTailored" Content="Tanılama Verisiyle Kişiselleştirilmiş İpuçlarını Kapat (TailoredExperiencesWithDiagnosticDataEnabled = 0)" IsChecked="True" Foreground="{DynamicResource TextWhite}" Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button x:Name="BtnApplyPrivacy" Click="BtnApplyPrivacy_Click" Background="{DynamicResource AccentEmerald}" BorderThickness="0" Margin="0,0,10,6">
                                    <TextBlock x:Name="TxtBtnApplyPrivacy" Text="Yedekle ve Seçili Gizlilik Kurallarını Uygula" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                                <Button x:Name="BtnRevertPrivacy" Click="BtnRevertPrivacy_Click" Background="{DynamicResource AccentAmber}" BorderThickness="0" Margin="0,0,10,6">
                                    <TextBlock x:Name="TxtBtnRevertPrivacy" Text="Kaydedilen Önceki Kullanıcı Durumuna Geri Yükle" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                                <Button x:Name="BtnRefreshStartup" Click="BtnRefreshStartup_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,10,6">
                                    <TextBlock x:Name="TxtBtnRefreshStartup" Text="Başlangıç Listesini Yenile" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="BtnToggleStartupItem" Click="BtnToggleStartupItem_Click" Background="{DynamicResource AccentCyan}" BorderThickness="0" Margin="0,0,10,6">
                                    <TextBlock x:Name="TxtBtnToggleStartupItem" Text="Seçili Başlangıç Öğesini Duraklat / Etkinleştir" FontWeight="Bold" Foreground="#090B10"/>
                                </Button>
                                <Button x:Name="BtnAuditScheduledTasks" Click="BtnAuditScheduledTasks_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtBtnAuditScheduledTasks" Text="Görev Zamanlayıcısı Denetimi" FontWeight="SemiBold"/>
                                </Button>
                            </WrapPanel>
                            <TextBlock x:Name="TxtPrivResult" Text="" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource AccentEmerald}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtStartupListHeader" Grid.Row="0" Text="Salt Okunur Başlangıç Denetimi (HKCU/HKLM Run, RunOnce ve Startup Klasörleri)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <ListBox x:Name="LstStartupApps" Grid.Row="1" Background="{DynamicResource BgSidebar}" Foreground="{DynamicResource TextWhite}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 6: POWER PLANS, CAFFEINE LOCK & TIMERS -->
                <Grid x:Name="TabStart" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtStartTitle" Text="Doğrulamalı Güç Planı Yönetimi, Uyku Kilidi &amp; Zamanlayıcı" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStartSubtitle" Text="Mevcut güç şemalarını sorgular, mükerrer plan üretmeden Nihai Performans planını etkinleştirip doğrular ve çıkışta uyku kilidini temizler." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,18"/>

                        <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtPowerSectionHeader" Text="Donanım Güç Planı ve Ekran Uyku Kilidi (Caffeine)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,16">
                                    <Button x:Name="BtnOpenStartup" Click="BtnOpenStartup_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,10,8">
                                        <TextBlock x:Name="TxtBtnOpenStartup" Text="Uyku Kilidini (Uyanık Tut) Başlat" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnUnlockPower" Click="BtnUnlockPower_Click" Background="{DynamicResource AccentAmber}" BorderThickness="0" Margin="0,0,10,8">
                                        <TextBlock x:Name="TxtBtnUnlockPower" Text="Nihai Performans Planını Doğrula ve Etkinleştir" FontWeight="Bold" Foreground="#090B10"/>
                                    </Button>
                                    <Button x:Name="BtnRestoreBalancedPower" Click="BtnRestoreBalancedPower_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtBtnRestoreBalancedPower" Text="Standart Dengeli (Balanced) Güç Planına Dön" FontWeight="SemiBold"/>
                                    </Button>
                                </WrapPanel>

                                <TextBlock x:Name="TxtVisualPerfHeader" Text="Görsel Performans Ayarları (Windows Arayüz ve Animasyon Hızlandırma)" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,10"/>
                                <WrapPanel Margin="0,0,0,16">
                                    <Button x:Name="BtnVisualBestPerf" Click="BtnVisualBestPerf_Click" Background="{DynamicResource AccentEmerald}" BorderThickness="0" Margin="0,0,10,8">
                                        <TextBlock x:Name="TxtBtnVisualBestPerf" Text="En İyi Performans Moduna Geç (Hantal Efektleri Kapat)" FontWeight="Bold" Foreground="#090B10"/>
                                    </Button>
                                    <Button x:Name="BtnVisualRestoreDefault" Click="BtnVisualRestoreDefault_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtBtnVisualRestoreDefault" Text="Görsel Efektleri Varsayılan Kaliteye Döndür" FontWeight="SemiBold"/>
                                    </Button>
                                </WrapPanel>

                                <TextBlock x:Name="TxtTimerSectionHeader" Text="Otomatik Sistem Kapatma Zamanlayıcısı" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="BtnShutdown30" Click="BtnShutdown30_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,10,8">
                                        <TextBlock x:Name="TxtBtnShutdown30" Text="30 Dk Sonra Kapat" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnShutdownTimer" Click="BtnShutdownTimer_Click" Background="{DynamicResource AccentCyan}" BorderThickness="0" Margin="0,0,10,8">
                                        <TextBlock x:Name="TxtBtnShutdown60" Text="60 Dk Sonra Otomatik Kapat" FontWeight="Bold" Foreground="#090B10"/>
                                    </Button>
                                    <Button x:Name="BtnShutdown120" Click="BtnShutdown120_Click" Background="{DynamicResource CardDarkHover}" Margin="0,0,10,8">
                                        <TextBlock x:Name="TxtBtnShutdown120" Text="120 Dk Sonra Kapat" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button x:Name="BtnCancelShutdown" Click="BtnCancelShutdown_Click" Background="#E11D48" BorderThickness="0" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtBtnCancelShutdown" Text="Zamanlayıcıyı İptal Et" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Button>
                                </WrapPanel>

                                <TextBlock x:Name="TxtPowerStatus" Text="" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource AccentEmerald}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgFooter}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtFooterLeft" Text="QOVX v4.0.1.1 • Yayıncı: ALLAHVERDİ CAN • %100 Yerel Mimari" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock x:Name="TxtFooterRight" HorizontalAlignment="Right" Text="Windows 10 / 11 x64 Native (.NET 10 LTS)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
