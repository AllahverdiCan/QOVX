<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>Qovx</AssemblyName>
    <RootNamespace>Qovx</RootNamespace>
    <Version>4.0.1.0</Version>
    <AssemblyVersion>4.0.1.0</AssemblyVersion>
    <FileVersion>4.0.1.0</FileVersion>
    <Company>ALLAHVERDİ CAN</Company>
    <Authors>ALLAHVERDİ CAN</Authors>
    <Product>QOVX - Windows System &amp; Network Control Suite</Product>
    <Description>Native Windows physical memory working-set trimmer, safe storage cache &amp; SHA-256 duplicate manager, UDP/TCP DNS resolver benchmark, reversible privacy rules, and power control suite.</Description>
    <Copyright>Copyright © 2026 ALLAHVERDİ CAN. All Rights Reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
