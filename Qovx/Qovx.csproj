<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>Qovx</AssemblyName>
    <RootNamespace>Qovx</RootNamespace>
    <Version>2.0.4</Version>
    <FileVersion>2.0.4.0</FileVersion>
    <AssemblyVersion>2.0.4.0</AssemblyVersion>
    <Authors>ALLAHVERDİ CAN</Authors>
    <Company>ALLAHVERDİ CAN</Company>
    <Product>QOVX System &amp; Network Control Suite</Product>
    <Description>Native Windows system, memory working-set, storage cache, and network latency control suite.</Description>
    <Copyright>Copyright © 2026 ALLAHVERDİ CAN. All rights reserved.</Copyright>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Package.appxmanifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
